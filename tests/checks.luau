local function findName(parent,name)
	if parent.Name==name then return parent end
	for _,child in ipairs(parent:GetChildren()) do local result=findName(child,name); if result then return result end end
end
local function findButton(parent,text)
	if parent:IsA("TextButton") and parent.Text==text then return parent end
	for _,child in ipairs(parent:GetChildren()) do local result=findButton(child,text); if result then return result end end
end
